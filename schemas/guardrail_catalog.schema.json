{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ambidgen/OSINT/schemas/guardrail_catalog.schema.json",
  "title": "OSINT Epistemic Guardrail Catalog",
  "description": "Schema for catalogs of logical fallacies, cognitive/media/data biases, and structured analytic techniques.",
  "type": "object",
  "required": ["catalog_type", "version", "description", "entries"],
  "additionalProperties": false,
  "properties": {
    "catalog_type": {
      "type": "string",
      "enum": [
        "logical_fallacies",
        "cognitive_and_media_biases",
        "structured_analytic_techniques"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "entries": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "definition",
          "osint_manifestation",
          "detection_signals",
          "remediation_protocol"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "definition": {
            "type": "string",
            "minLength": 20
          },
          "osint_manifestation": {
            "type": "string",
            "minLength": 20
          },
          "detection_signals": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "remediation_protocol": {
            "type": "string",
            "minLength": 20
          },
          "high_prevalence_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "geopolitics_diplomacy",
                "conflict_defense_security",
                "economics_markets_trade",
                "technology_cyber_ai",
                "science_medicine_public_health",
                "climate_energy_environment",
                "law_governance_human_rights",
                "society_demographics_labor"
              ]
            }
          }
        }
      }
    }
  }
}
